        .hero-title {
            font-size: clamp(2.4rem, 6vw, 6rem);
            letter-spacing: 2px;
            color: #222;
        }

        .hero-watch {
            transform: translateX(10%);
        }

        @media (max-width: 991px) {
            .hero-watch {
                transform: none;
                max-width: 300px;
                margin: auto;
            }
        }

        .card-img-top {
            background-color: #f7f7f7;
        }

        .new-year-sale {
            background-color: #eef4f6;
        }

        .post-card-img {
            max-height: 200px;
            object-fit: cover;
        }

        .footer-link {
            text-decoration: none;
            color: #6c757d;
        }

        /* كود تصغير النقاط (Indicators) */
        .carousel-indicators [data-bs-target] {
            width: 8px; 
            height: 8px; 
            border-radius: 50%;
            margin: 0 5px;
            background-color: #000;
        }

        /* تنسيق Go To Shop و Read Blog */
        .product-label {
            position: absolute;
            top: 0; 
            right: 0;
            padding: 0.25rem 0.5rem;
            font-size: 0.75rem;
            font-weight: bold;
            color: #000;
            background-color: #eef4f6; 
            text-decoration: none;
            z-index: 10;
        }

        .card-img-container {
            position: relative;
        }
    </style>
</head>

